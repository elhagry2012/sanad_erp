# انسخ هذا الملف إلى .env (ولا ترفعه لأي مستودع). متغيرات البيئة الفعلية لها الأولوية على الملف.

# development | production
SANAD_ENV=production

# مسارات البيانات: ضعها على قرص دائم (Volume) في السحابة
SANAD_DB_PATH=/data/sanad.db
SANAD_BACKUP_DIR=/data/backups
SANAD_IMAGES_DIR=/data/invoice_images

# كلمة مرور المدير العام (momar) تُستخدم مرة واحدة عند إنشاء الحساب فقط.
# إن تركتها فارغة تُولَّد كلمة عشوائية وتُطبع في سجل الخادم. في الحالتين يُجبَر على تغييرها عند أول دخول.
SANAD_ADMIN_PASSWORD=

# الجلسات والأمان
SANAD_SESSION_IDLE_MINUTES=30
SANAD_SESSION_MAX_HOURS=12
SANAD_MAX_FAILED_LOGINS=5
SANAD_LOCKOUT_MINUTES=10
SANAD_PBKDF2_ITERATIONS=600000

SANAD_KEEP_BACKUPS=30
